        "activityViewerRoles": ["GESTIONNAIRE_STOCK", "SERVICE_CLIENT"],
        "dataViewerRoles": ["GESTIONNAIRE_STOCK", "SERVICE_CLIENT"]
      }
    },
    "UserTask_Proposer_Solution": {
      "activityId": "proposer_solution",
      "activityType": "MANUAL",
      "assignment": {
        "candidateRoles": ["SERVICE_CLIENT"],
