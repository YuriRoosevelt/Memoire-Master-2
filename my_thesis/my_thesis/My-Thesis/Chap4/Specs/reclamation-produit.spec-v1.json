        "strategy": "ROLE_BASED"
      },
      "input": {
        "sources": ["PROCESS_CONTEXT"],
        "fields": ["solutionProposee", "commentaireCommercial"]
      },
      "output": {
        "storage": "PROCESS_CONTEXT",
        "fields": ["solutionProposee", "commentaireRevision"]
