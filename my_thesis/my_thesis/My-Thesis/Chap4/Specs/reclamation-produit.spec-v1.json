        "activityViewerRoles": ["GESTIONNAIRE_STOCK", "SERVICE_CLIENT", "ADMINISTRATEUR"],
        "dataViewerRoles": ["GESTIONNAIRE_STOCK", "SERVICE_CLIENT"]
      }
