      "visibility": {
        "activityViewerRoles": ["SERVICE_CLIENT", "SERVICE_COMMERCIAL", "ADMINISTRATEUR"],
        "dataViewerRoles": ["SERVICE_CLIENT", "SERVICE_COMMERCIAL", "ADMINISTRATEUR"]
      }
    },
