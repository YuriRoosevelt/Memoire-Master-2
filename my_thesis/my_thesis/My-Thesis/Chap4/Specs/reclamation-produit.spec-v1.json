      "visibility": {
        "activityViewerRoles": ["SERVICE_CLIENT", "SERVICE_COMMERCIAL", "ADMINISTRATEUR"],
        "dataViewerRoles": ["CLIENT", "SERVICE_CLIENT", "SERVICE_COMMERCIAL"]
      }
