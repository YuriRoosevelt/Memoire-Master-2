{
  "processId": "Process_P3_Reclamation_Produit",
  "processKey": "reclamation_produit",
  "schemaVersion": 1,
  "name": "Réclamation de produit",
  "description": "Processus de qualification, analyse, décision et clôture d'une réclamation de produit dans l'organisation e-commerce.",
  "start": {
    "allowedRoles": ["CLIENT"],
    "startActivities": ["UserTask_Deposer_Reclamation_Produit"]
  },
  "monitoring": {
    "supervisorRoles": ["SERVICE_CLIENT", "SERVICE_COMMERCIAL", "ADMINISTRATEUR"]
  },
  "activities": {
    "UserTask_Deposer_Reclamation_Produit": {
      "activityId": "deposer_reclamation_produit",
      "activityType": "MANUAL",
      "assignment": {
        "candidateRoles": ["CLIENT"],
        "mode": "DIRECT",
        "strategy": "ROLE_BASED"
      },
      "input": {
        "sources": ["CLIENT_PROFILE", "SHARED_DATA"],
        "fields": ["client.identite", "commande.numero", "produit.reference"]
      },
      "output": {
        "storage": "BOTH",
        "fields": ["reclamation.numero", "reclamation.motif", "reclamation.description"]
      },
      "visibility": {
        "activityViewerRoles": ["CLIENT", "SERVICE_CLIENT"],
        "dataViewerRoles": ["CLIENT", "SERVICE_CLIENT"]
      }
    },
    "UserTask_Qualifier_Reclamation": {
      "activityId": "qualifier_reclamation",
      "activityType": "MANUAL",
      "assignment": {
        "candidateRoles": ["SERVICE_CLIENT"],
        "mode": "CLAIM",
        "strategy": "ROLE_BASED"
      },
      "input": {
        "sources": ["PROCESS_CONTEXT"],
        "fields": ["reclamation.numero", "reclamation.motif", "reclamation.description"]
      },
      "output": {
        "storage": "PROCESS_CONTEXT",
        "fields": ["categorieReclamation", "commentaireQualification"]
