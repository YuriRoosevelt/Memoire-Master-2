<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="Definitions_P1_Commande_Client_Organisation_Ecommerce"
                  targetNamespace="http://prooweb.cm/bpmn/P1_Commande_Client_Organisation_Ecommerce"
                  exporter="ChatGPT"
                  exporterVersion="BPMN 2.0">
  <bpmn:collaboration id="Collaboration_P1_Commande_Client">
    <bpmn:participant id="Participant_OrganisationEcommerce" name="Organisation e-commerce" processRef="Process_P1_Commande_Client" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P1_Commande_Client" name="P1 — Commande Client" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P1_Commande_Client">
      <bpmn:lane id="Lane_Client" name="Client">
        <bpmn:flowNodeRef>StartEvent_Debut</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PasserCommande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConsulterConfirmation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CommandeConfirmee</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ServiceCommercial" name="Service commercial">
        <bpmn:flowNodeRef>UserTask_VerifierInfosCommande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_CommandeRecevable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_AnnulerCommande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_NotifierAnnulationClient</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CommandeAnnulee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ValiderCommande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_InformerClientAttente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_CommandeEnAttente</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_ConfirmerCommandePreparee</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_GestionnaireStock" name="Gestionnaire de stock">
        <bpmn:flowNodeRef>UserTask_VerifierDisponibiliteProduits</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_StockDisponible</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_MarquerCommandeAttenteStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_PreparerCommande</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_EnregistrerPreparation</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Debut" name="Début">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="UserTask_PasserCommande" name="Passer la commande
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le client saisit et soumet sa commande.</bpmn:documentation>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_VerifierInfosCommande" name="Vérifier les informations de la commande
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le service commercial contrôle les informations de la commande.</bpmn:documentation>
      <bpmn:incoming>Flow_02</bpmn:incoming>
      <bpmn:outgoing>Flow_03</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CommandeRecevable" name="Commande recevable ?">
      <bpmn:incoming>Flow_03</bpmn:incoming>
      <bpmn:outgoing>Flow_04_Non</bpmn:outgoing>
      <bpmn:outgoing>Flow_07_Oui</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_AnnulerCommande" name="Annuler la commande
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le service commercial annule la commande non recevable.</bpmn:documentation>
      <bpmn:incoming>Flow_04_Non</bpmn:incoming>
      <bpmn:outgoing>Flow_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_NotifierAnnulationClient" name="Notifier l'annulation au client
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le service commercial enregistre la notification d'annulation visible par le client.</bpmn:documentation>
      <bpmn:incoming>Flow_05</bpmn:incoming>
      <bpmn:outgoing>Flow_06</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_CommandeAnnulee" name="Commande annulée">
      <bpmn:incoming>Flow_06</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_ValiderCommande" name="Valider la commande
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le service commercial valide la commande recevable.</bpmn:documentation>
      <bpmn:incoming>Flow_07_Oui</bpmn:incoming>
      <bpmn:outgoing>Flow_08</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_VerifierDisponibiliteProduits" name="Vérifier la disponibilité des produits
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le gestionnaire de stock vérifie les quantités disponibles.</bpmn:documentation>
      <bpmn:incoming>Flow_08</bpmn:incoming>
      <bpmn:outgoing>Flow_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_StockDisponible" name="Stock disponible ?">
      <bpmn:incoming>Flow_09</bpmn:incoming>
      <bpmn:outgoing>Flow_10_Non</bpmn:outgoing>
      <bpmn:outgoing>Flow_13_Oui</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_MarquerCommandeAttenteStock" name="Marquer la commande en attente de stock
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le gestionnaire de stock marque la commande comme étant en attente.</bpmn:documentation>
      <bpmn:incoming>Flow_10_Non</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_InformerClientAttente" name="Informer le client de l'attente
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le service commercial enregistre l'information d'attente de stock visible par le client.</bpmn:documentation>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_CommandeEnAttente" name="Client informé de l’attente">
      <bpmn:incoming>Flow_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_PreparerCommande" name="Préparer la commande
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le gestionnaire de stock prépare la commande et renseigne son traitement dans l'application.</bpmn:documentation>
      <bpmn:incoming>Flow_13_Oui</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_EnregistrerPreparation" name="Enregistrer la préparation
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le gestionnaire de stock enregistre la préparation dans le système.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_ConfirmerCommandePreparee" name="Confirmer la commande préparée
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le service commercial confirme dans l'application que la commande est préparée.</bpmn:documentation>
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_ConsulterConfirmation" name="Consulter la confirmation
(User Task)">
      <bpmn:documentation>Type BPMN : User Task. Le client consulte la confirmation de sa commande.</bpmn:documentation>
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_CommandeConfirmee" name="Commande confirmée">
      <bpmn:incoming>Flow_17</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="StartEvent_Debut" targetRef="UserTask_PasserCommande">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_02" sourceRef="UserTask_PasserCommande" targetRef="UserTask_VerifierInfosCommande">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_03" sourceRef="UserTask_VerifierInfosCommande" targetRef="Gateway_CommandeRecevable">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_04_Non" name="Non" sourceRef="Gateway_CommandeRecevable" targetRef="UserTask_AnnulerCommande">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${commandeRecevable == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_05" sourceRef="UserTask_AnnulerCommande" targetRef="UserTask_NotifierAnnulationClient">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_06" sourceRef="UserTask_NotifierAnnulationClient" targetRef="EndEvent_CommandeAnnulee">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_07_Oui" name="Oui" sourceRef="Gateway_CommandeRecevable" targetRef="UserTask_ValiderCommande">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${commandeRecevable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_08" sourceRef="UserTask_ValiderCommande" targetRef="UserTask_VerifierDisponibiliteProduits">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_09" sourceRef="UserTask_VerifierDisponibiliteProduits" targetRef="Gateway_StockDisponible">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_10_Non" name="Non" sourceRef="Gateway_StockDisponible" targetRef="UserTask_MarquerCommandeAttenteStock">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stockDisponible == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="UserTask_MarquerCommandeAttenteStock" targetRef="UserTask_InformerClientAttente">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="UserTask_InformerClientAttente" targetRef="EndEvent_CommandeEnAttente">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_13_Oui" name="Oui" sourceRef="Gateway_StockDisponible" targetRef="UserTask_PreparerCommande">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${stockDisponible == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_14" sourceRef="UserTask_PreparerCommande" targetRef="UserTask_EnregistrerPreparation">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_15" sourceRef="UserTask_EnregistrerPreparation" targetRef="UserTask_ConfirmerCommandePreparee">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_16" sourceRef="UserTask_ConfirmerCommandePreparee" targetRef="UserTask_ConsulterConfirmation">
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_17" sourceRef="UserTask_ConsulterConfirmation" targetRef="EndEvent_CommandeConfirmee">
    </bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_P1_Commande_Client">
    <bpmndi:BPMNPlane id="BPMNPlane_P1_Commande_Client" bpmnElement="Collaboration_P1_Commande_Client">
      <bpmndi:BPMNShape id="Participant_OrganisationEcommerce_di" bpmnElement="Participant_OrganisationEcommerce" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2500" height="660" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Client_di" bpmnElement="Lane_Client" isHorizontal="true">
        <dc:Bounds x="190" y="80" width="2470" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ServiceCommercial_di" bpmnElement="Lane_ServiceCommercial" isHorizontal="true">
        <dc:Bounds x="190" y="300" width="2470" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_GestionnaireStock_di" bpmnElement="Lane_GestionnaireStock" isHorizontal="true">
        <dc:Bounds x="190" y="520" width="2470" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartEvent_Debut_di" bpmnElement="StartEvent_Debut">
        <dc:Bounds x="230" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_PasserCommande_di" bpmnElement="UserTask_PasserCommande">
        <dc:Bounds x="320" y="150" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_VerifierInfosCommande_di" bpmnElement="UserTask_VerifierInfosCommande">
        <dc:Bounds x="540" y="370" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_CommandeRecevable_di" bpmnElement="Gateway_CommandeRecevable">
        <dc:Bounds x="790" y="385" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_AnnulerCommande_di" bpmnElement="UserTask_AnnulerCommande">
        <dc:Bounds x="920" y="325" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_NotifierAnnulationClient_di" bpmnElement="UserTask_NotifierAnnulationClient">
        <dc:Bounds x="1130" y="325" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CommandeAnnulee_di" bpmnElement="EndEvent_CommandeAnnulee">
        <dc:Bounds x="1380" y="347" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ValiderCommande_di" bpmnElement="UserTask_ValiderCommande">
        <dc:Bounds x="920" y="425" width="170" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_VerifierDisponibiliteProduits_di" bpmnElement="UserTask_VerifierDisponibiliteProduits">
        <dc:Bounds x="1130" y="590" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_StockDisponible_di" bpmnElement="Gateway_StockDisponible">
        <dc:Bounds x="1400" y="605" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_MarquerCommandeAttenteStock_di" bpmnElement="UserTask_MarquerCommandeAttenteStock">
        <dc:Bounds x="1520" y="590" width="230" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_InformerClientAttente_di" bpmnElement="UserTask_InformerClientAttente">
        <dc:Bounds x="1800" y="370" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CommandeEnAttente_di" bpmnElement="EndEvent_CommandeEnAttente">
        <dc:Bounds x="2070" y="392" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_PreparerCommande_di" bpmnElement="UserTask_PreparerCommande">
        <dc:Bounds x="1520" y="650" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_EnregistrerPreparation_di" bpmnElement="UserTask_EnregistrerPreparation">
        <dc:Bounds x="1800" y="650" width="200" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ConfirmerCommandePreparee_di" bpmnElement="UserTask_ConfirmerCommandePreparee">
        <dc:Bounds x="2070" y="370" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UserTask_ConsulterConfirmation_di" bpmnElement="UserTask_ConsulterConfirmation">
        <dc:Bounds x="2330" y="150" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndEvent_CommandeConfirmee_di" bpmnElement="EndEvent_CommandeConfirmee">
        <dc:Bounds x="2545" y="172" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01">
        <di:waypoint x="266" y="190" />
        <di:waypoint x="320" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02">
        <di:waypoint x="480" y="190" />
        <di:waypoint x="510" y="190" />
        <di:waypoint x="510" y="410" />
        <di:waypoint x="540" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_03_di" bpmnElement="Flow_03">
        <di:waypoint x="730" y="410" />
        <di:waypoint x="790" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_04_Non_di" bpmnElement="Flow_04_Non">
        <di:waypoint x="840" y="410" />
        <di:waypoint x="880" y="410" />
        <di:waypoint x="880" y="365" />
        <di:waypoint x="920" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_05_di" bpmnElement="Flow_05">
        <di:waypoint x="1090" y="365" />
        <di:waypoint x="1130" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_06_di" bpmnElement="Flow_06">
        <di:waypoint x="1320" y="365" />
        <di:waypoint x="1380" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_07_Oui_di" bpmnElement="Flow_07_Oui">
        <di:waypoint x="840" y="410" />
        <di:waypoint x="880" y="410" />
        <di:waypoint x="880" y="465" />
        <di:waypoint x="920" y="465" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_08_di" bpmnElement="Flow_08">
        <di:waypoint x="1090" y="465" />
        <di:waypoint x="1110" y="465" />
        <di:waypoint x="1110" y="630" />
        <di:waypoint x="1130" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_09_di" bpmnElement="Flow_09">
        <di:waypoint x="1340" y="630" />
        <di:waypoint x="1400" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_10_Non_di" bpmnElement="Flow_10_Non">
        <di:waypoint x="1450" y="630" />
        <di:waypoint x="1520" y="630" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_11_di" bpmnElement="Flow_11">
        <di:waypoint x="1750" y="630" />
        <di:waypoint x="1775" y="630" />
        <di:waypoint x="1775" y="410" />
        <di:waypoint x="1800" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_12_di" bpmnElement="Flow_12">
        <di:waypoint x="2010" y="410" />
        <di:waypoint x="2070" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_13_Oui_di" bpmnElement="Flow_13_Oui">
        <di:waypoint x="1425" y="655" />
        <di:waypoint x="1425" y="690" />
        <di:waypoint x="1520" y="690" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_14_di" bpmnElement="Flow_14">
        <di:waypoint x="1710" y="690" />
        <di:waypoint x="1800" y="690" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_15_di" bpmnElement="Flow_15">
        <di:waypoint x="2000" y="690" />
        <di:waypoint x="2030" y="690" />
        <di:waypoint x="2030" y="410" />
        <di:waypoint x="2070" y="410" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_16_di" bpmnElement="Flow_16">
        <di:waypoint x="2290" y="410" />
        <di:waypoint x="2320" y="410" />
        <di:waypoint x="2320" y="190" />
        <di:waypoint x="2330" y="190" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_17_di" bpmnElement="Flow_17">
        <di:waypoint x="2520" y="190" />
        <di:waypoint x="2545" y="190" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
