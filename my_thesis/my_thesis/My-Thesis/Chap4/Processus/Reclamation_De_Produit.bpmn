<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_P3_Reclamation_Produit" targetNamespace="http://prooweb.example/bpmn/p3-reclamation-produit" exporter="bpmn-js (https://demo.bpmn.io)" exporterVersion="18.16.0">
  <bpmn:collaboration id="Collaboration_P3_Reclamation_Produit">
    <bpmn:participant id="Participant_Organisation_Ecommerce" name="Organisation e-commerce" processRef="Process_P3_Reclamation_Produit" />
  </bpmn:collaboration>
  <bpmn:process id="Process_P3_Reclamation_Produit" name="P3 Réclamation de produit" isExecutable="false">
    <bpmn:laneSet id="LaneSet_P3_Reclamation_Produit">
      <bpmn:lane id="Lane_Gestionnaire_Stock" name="Gestionnaire de stock">
        <bpmn:flowNodeRef>UserTask_Verifier_Reference_Etat_Produit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Renseigner_Resultat_Verification</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service_Commercial" name="Service commercial">
        <bpmn:flowNodeRef>UserTask_Examiner_Solution_Proposee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Solution_Acceptee</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Service_Client" name="Service client">
        <bpmn:flowNodeRef>UserTask_Qualifier_Reclamation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Verifier_Commande_Concernee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reclamation_Rejetee</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Analyser_Motif_Reclamation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Verification_Stock_Necessaire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Enregistrer_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Notifier_Client_Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Cloturer_Reclamation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Reviser_Solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Proposer_Solution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Validation_Commerciale_Necessaire</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Rejeter_Reclamation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Notifier_Client_Rejet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Reclamation_Recevable</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Client" name="Client">
        <bpmn:flowNodeRef>UserTask_Consulter_Reponse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UserTask_Deposer_Reclamation_Produit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>StartEvent_Debut_Reclamation</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reclamation_Cloturee</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="UserTask_Qualifier_Reclamation" name="Qualifier la réclamation">
      <bpmn:incoming>Flow_002</bpmn:incoming>
      <bpmn:outgoing>Flow_003</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Verifier_Commande_Concernee" name="Vérifier la commande concernée">
      <bpmn:incoming>Flow_003</bpmn:incoming>
      <bpmn:outgoing>Flow_004</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Reclamation_Rejetee" name="Fin">
      <bpmn:incoming>Flow_007</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="UserTask_Analyser_Motif_Reclamation" name="Analyser le motif de réclamation">
      <bpmn:incoming>Flow_008_Oui</bpmn:incoming>
      <bpmn:outgoing>Flow_009</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Verification_Stock_Necessaire" name="Vérification stock nécessaire ?">
      <bpmn:incoming>Flow_009</bpmn:incoming>
      <bpmn:outgoing>Flow_010_Oui</bpmn:outgoing>
      <bpmn:outgoing>Flow_013_Non</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_Verifier_Reference_Etat_Produit" name="Vérifier la référence et l&#39;état du produit">
      <bpmn:incoming>Flow_010_Oui</bpmn:incoming>
      <bpmn:outgoing>Flow_011</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Renseigner_Resultat_Verification" name="Renseigner le résultat de vérification">
      <bpmn:incoming>Flow_011</bpmn:incoming>
      <bpmn:outgoing>Flow_012</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Examiner_Solution_Proposee" name="Examiner la solution proposée">
      <bpmn:incoming>Flow_015_Oui</bpmn:incoming>
      <bpmn:outgoing>Flow_016</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Solution_Acceptee" name="Solution acceptée ?">
      <bpmn:incoming>Flow_016</bpmn:incoming>
      <bpmn:outgoing>Flow_017_Non</bpmn:outgoing>
      <bpmn:outgoing>Flow_019_Oui</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_Enregistrer_Decision" name="Enregistrer la décision">
      <bpmn:incoming>Flow_019_Oui</bpmn:incoming>
      <bpmn:incoming>Flow_020_Non</bpmn:incoming>
      <bpmn:outgoing>Flow_021</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Notifier_Client_Decision" name="Notifier le client">
      <bpmn:incoming>Flow_021</bpmn:incoming>
      <bpmn:outgoing>Flow_022</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Cloturer_Reclamation" name="Clôturer la réclamation">
      <bpmn:incoming>Flow_022</bpmn:incoming>
      <bpmn:outgoing>Flow_023</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Consulter_Reponse" name="Consulter la réponse">
      <bpmn:incoming>Flow_023</bpmn:incoming>
      <bpmn:outgoing>Flow_024</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Reviser_Solution" name="Réviser la solution">
      <bpmn:incoming>Flow_017_Non</bpmn:incoming>
      <bpmn:outgoing>Flow_018</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Proposer_Solution" name="Proposer une solution">
      <bpmn:incoming>Flow_012</bpmn:incoming>
      <bpmn:incoming>Flow_013_Non</bpmn:incoming>
      <bpmn:incoming>Flow_018</bpmn:incoming>
      <bpmn:outgoing>Flow_014</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Validation_Commerciale_Necessaire" name="Validation commerciale nécessaire ?">
      <bpmn:incoming>Flow_014</bpmn:incoming>
      <bpmn:outgoing>Flow_015_Oui</bpmn:outgoing>
      <bpmn:outgoing>Flow_020_Non</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_Rejeter_Reclamation" name="Rejeter la réclamation">
      <bpmn:incoming>Flow_005_Non</bpmn:incoming>
      <bpmn:outgoing>Flow_006</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="UserTask_Notifier_Client_Rejet" name="Notifier le client du rejet">
      <bpmn:incoming>Flow_006</bpmn:incoming>
      <bpmn:outgoing>Flow_007</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Reclamation_Recevable" name="Réclamation recevable ?">
      <bpmn:incoming>Flow_004</bpmn:incoming>
      <bpmn:outgoing>Flow_005_Non</bpmn:outgoing>
      <bpmn:outgoing>Flow_008_Oui</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="UserTask_Deposer_Reclamation_Produit" name="Déposer une réclamation produit">
      <bpmn:incoming>Flow_001</bpmn:incoming>
      <bpmn:outgoing>Flow_002</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:startEvent id="StartEvent_Debut_Reclamation" name="Début">
      <bpmn:outgoing>Flow_001</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:endEvent id="EndEvent_Reclamation_Cloturee" name="Fin">
      <bpmn:incoming>Flow_024</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_002" sourceRef="UserTask_Deposer_Reclamation_Produit" targetRef="UserTask_Qualifier_Reclamation" />
    <bpmn:sequenceFlow id="Flow_003" sourceRef="UserTask_Qualifier_Reclamation" targetRef="UserTask_Verifier_Commande_Concernee" />
    <bpmn:sequenceFlow id="Flow_004" sourceRef="UserTask_Verifier_Commande_Concernee" targetRef="Gateway_Reclamation_Recevable" />
    <bpmn:sequenceFlow id="Flow_007" sourceRef="UserTask_Notifier_Client_Rejet" targetRef="EndEvent_Reclamation_Rejetee" />
    <bpmn:sequenceFlow id="Flow_008_Oui" name="Oui" sourceRef="Gateway_Reclamation_Recevable" targetRef="UserTask_Analyser_Motif_Reclamation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reclamationRecevable == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_009" sourceRef="UserTask_Analyser_Motif_Reclamation" targetRef="Gateway_Verification_Stock_Necessaire" />
    <bpmn:sequenceFlow id="Flow_010_Oui" name="Oui" sourceRef="Gateway_Verification_Stock_Necessaire" targetRef="UserTask_Verifier_Reference_Etat_Produit">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verificationStockNecessaire == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_013_Non" name="Non" sourceRef="Gateway_Verification_Stock_Necessaire" targetRef="UserTask_Proposer_Solution">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${verificationStockNecessaire == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_011" sourceRef="UserTask_Verifier_Reference_Etat_Produit" targetRef="UserTask_Renseigner_Resultat_Verification" />
    <bpmn:sequenceFlow id="Flow_012" sourceRef="UserTask_Renseigner_Resultat_Verification" targetRef="UserTask_Proposer_Solution" />
    <bpmn:sequenceFlow id="Flow_015_Oui" name="Oui" sourceRef="Gateway_Validation_Commerciale_Necessaire" targetRef="UserTask_Examiner_Solution_Proposee">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${validationCommercialeNecessaire == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_016" sourceRef="UserTask_Examiner_Solution_Proposee" targetRef="Gateway_Solution_Acceptee" />
    <bpmn:sequenceFlow id="Flow_017_Non" name="Non" sourceRef="Gateway_Solution_Acceptee" targetRef="UserTask_Reviser_Solution">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${solutionAcceptee == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_019_Oui" name="Oui" sourceRef="Gateway_Solution_Acceptee" targetRef="UserTask_Enregistrer_Decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${solutionAcceptee == true}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_020_Non" name="Non" sourceRef="Gateway_Validation_Commerciale_Necessaire" targetRef="UserTask_Enregistrer_Decision">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${validationCommercialeNecessaire == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_021" sourceRef="UserTask_Enregistrer_Decision" targetRef="UserTask_Notifier_Client_Decision" />
    <bpmn:sequenceFlow id="Flow_022" sourceRef="UserTask_Notifier_Client_Decision" targetRef="UserTask_Cloturer_Reclamation" />
    <bpmn:sequenceFlow id="Flow_023" sourceRef="UserTask_Cloturer_Reclamation" targetRef="UserTask_Consulter_Reponse" />
    <bpmn:sequenceFlow id="Flow_024" sourceRef="UserTask_Consulter_Reponse" targetRef="EndEvent_Reclamation_Cloturee" />
    <bpmn:sequenceFlow id="Flow_018" sourceRef="UserTask_Reviser_Solution" targetRef="UserTask_Proposer_Solution" />
    <bpmn:sequenceFlow id="Flow_014" sourceRef="UserTask_Proposer_Solution" targetRef="Gateway_Validation_Commerciale_Necessaire" />
    <bpmn:sequenceFlow id="Flow_005_Non" name="Non" sourceRef="Gateway_Reclamation_Recevable" targetRef="UserTask_Rejeter_Reclamation">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">${reclamationRecevable == false}</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_006" sourceRef="UserTask_Rejeter_Reclamation" targetRef="UserTask_Notifier_Client_Rejet" />
    <bpmn:sequenceFlow id="Flow_001" sourceRef="StartEvent_Debut_Reclamation" targetRef="UserTask_Deposer_Reclamation_Produit" />
  </bpmn:process>
